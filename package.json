{
  "name": "local-image-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Merge, resize, convert and compress photos entirely in the browser, with optional AI alt text and crop suggestions.",
  "license": "MIT",
  "author": "Samiul Huda",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "setup": "npm install && npm run eval:samples",
    "demo": "vite --open",
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:samples": "node --experimental-strip-types eval/make-samples.ts",
    "eval:size": "node --experimental-strip-types eval/size-reduction.ts",
    "eval:alt": "node --experimental-strip-types eval/alt-text.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "playwright-core": "^1.53.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
